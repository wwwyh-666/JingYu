# 2026-11-10团队选用DeepSeek官方；本文件不得填真实密钥。
# 本轮已选deepseek；适配器固定非流式、非思考模式。其他provider仅保留兼容。
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=1600
# 模型管线额外修订轮数：0=仅一次生成+一次独立核验（失败即拒答，不再修订）；缺省1=允许一次修订（原行为）。
# 合法范围仅 0 或 1；其他值（2、负数、非整数）将在服务启动时明确报错。
MAX_REVISIONS=1
# 精确允许本地 B 端开发地址，待联调确认
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
