{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "spot_id": {
          "enum": [
            "TT",
            "GG",
            "ZGL",
            "YHY",
            "JS",
            "GWF",
            "YHG",
            "ZYM"
          ],
          "title": "Spot Id",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "period": {
          "title": "Period",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Sha256",
          "type": "string"
        },
        "usage": {
          "default": "answer",
          "enum": [
            "answer",
            "context_only",
            "suspected_typo"
          ],
          "title": "Usage",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "pending_human_review",
            "approved",
            "rejected",
            "disabled"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "evidence_id",
        "fact_id",
        "spot_id",
        "object_id",
        "period",
        "source_id",
        "url",
        "quote",
        "locator",
        "quote_sha256",
        "review_status"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "institution": {
          "title": "Institution",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "accessed_on": {
          "title": "Accessed On",
          "type": "string"
        },
        "published_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published On"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "pending_human_review",
            "approved",
            "rejected",
            "disabled"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "approved_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Approved Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "title",
        "institution",
        "url",
        "accessed_on",
        "locator",
        "review_status"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/Source"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "source",
    "evidence"
  ],
  "title": "SourceResponse",
  "type": "object"
}
