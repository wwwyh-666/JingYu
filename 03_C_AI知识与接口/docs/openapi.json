{
  "openapi": "3.1.0",
  "info": {
    "title": "京遇 C 初始化接口",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/spots": {
      "get": {
        "summary": "Spots",
        "operationId": "spots_spots_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpotsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/journal/draft": {
      "post": {
        "summary": "Draft",
        "operationId": "draft_journal_draft_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "501": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "spot_id": {
            "type": "string",
            "enum": [
              "TT",
              "GG",
              "ZGL",
              "YHY",
              "JS",
              "GWF",
              "YHG",
              "ZYM"
            ],
            "title": "Spot Id"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "turn_id": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Turn Id",
            "default": 1
          },
          "object_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Object Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spot_id",
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "spot_id": {
            "type": "string",
            "enum": [
              "TT",
              "GG",
              "ZGL",
              "YHY",
              "JS",
              "GWF",
              "YHG",
              "ZYM"
            ],
            "title": "Spot Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "turn_id": {
            "type": "integer",
            "title": "Turn Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fact Ids"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "confidence_flag": {
            "type": "string",
            "enum": [
              "mock",
              "insufficient_evidence",
              "supported"
            ],
            "title": "Confidence Flag"
          },
          "check_status": {
            "type": "string",
            "enum": [
              "not_checked",
              "human_reviewed"
            ],
            "title": "Check Status"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock"
          },
          "model_called": {
            "type": "boolean",
            "title": "Model Called"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spot_id",
          "session_id",
          "turn_id",
          "answer",
          "fact_ids",
          "citations",
          "confidence_flag",
          "check_status",
          "is_mock",
          "model_called"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "title": "Citation"
      },
      "DraftRequest": {
        "properties": {
          "spot_id": {
            "type": "string",
            "enum": [
              "TT",
              "GG",
              "ZGL",
              "YHY",
              "JS",
              "GWF",
              "YHG",
              "ZYM"
            ],
            "title": "Spot Id"
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "title": "Prompt",
            "default": ""
          },
          "media_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Media Ids"
          },
          "fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Fact Ids"
          },
          "visibility": {
            "type": "string",
            "const": "private",
            "title": "Visibility",
            "default": "private"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spot_id"
        ],
        "title": "DraftRequest"
      },
      "Geo": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng"
          },
          "crs": {
            "type": "string",
            "enum": [
              "WGS84",
              "GCJ02"
            ],
            "title": "Crs"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lat",
          "lng",
          "crs",
          "source_url"
        ],
        "title": "Geo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 1920.0,
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1080.0,
            "minimum": 0.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Position"
      },
      "Spot": {
        "properties": {
          "spot_id": {
            "type": "string",
            "enum": [
              "TT",
              "GG",
              "ZGL",
              "YHY",
              "JS",
              "GWF",
              "YHG",
              "ZYM"
            ],
            "title": "Spot Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "theme": {
            "type": "string",
            "title": "Theme"
          },
          "aesthetic_type": {
            "type": "string",
            "title": "Aesthetic Type"
          },
          "depth": {
            "type": "string",
            "enum": [
              "deep",
              "basic"
            ],
            "title": "Depth"
          },
          "map_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_key": {
            "type": "string",
            "title": "Image Key"
          },
          "asset_status": {
            "type": "string",
            "const": "pending_A_B",
            "title": "Asset Status",
            "default": "pending_A_B"
          },
          "geo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Geo"
              },
              {
                "type": "null"
              }
            ]
          },
          "name_source": {
            "type": "string",
            "title": "Name Source"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "pending_human_review",
              "approved",
              "rejected"
            ],
            "title": "Review Status",
            "default": "pending_human_review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "spot_id",
          "name",
          "theme",
          "aesthetic_type",
          "depth",
          "image_key",
          "name_source"
        ],
        "title": "Spot"
      },
      "SpotsResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "0.1.0"
          },
          "data_status": {
            "type": "string",
            "const": "template",
            "title": "Data Status",
            "default": "template"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Spot"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "SpotsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
