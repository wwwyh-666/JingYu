{
  "$defs": {
    "FactEvidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "supports": {
          "minLength": 1,
          "title": "Supports",
          "type": "string"
        },
        "relation": {
          "default": "supports",
          "enum": [
            "supports",
            "context_only",
            "conflicts"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator",
        "supports"
      ],
      "title": "FactEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fact_id": {
      "minLength": 1,
      "title": "Fact Id",
      "type": "string"
    },
    "spot_id": {
      "enum": [
        "TT",
        "GG",
        "ZGL",
        "YHY",
        "JS",
        "GWF",
        "YHG",
        "ZYM"
      ],
      "title": "Spot Id",
      "type": "string"
    },
    "object_id": {
      "title": "Object Id",
      "type": "string"
    },
    "period": {
      "title": "Period",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Keywords",
      "type": "array"
    },
    "query_aliases": {
      "items": {
        "type": "string"
      },
      "title": "Query Aliases",
      "type": "array"
    },
    "review_status": {
      "enum": [
        "pending_human_review",
        "approved",
        "rejected",
        "disabled"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "dispute_status": {
      "default": "not_assessed",
      "enum": [
        "disputed",
        "not_assessed"
      ],
      "title": "Dispute Status",
      "type": "string"
    },
    "statement_type": {
      "anyOf": [
        {
          "enum": [
            "direct_source_paraphrase",
            "multi_source_synthesis"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statement Type"
    },
    "source_evidence": {
      "items": {
        "$ref": "#/$defs/FactEvidence"
      },
      "title": "Source Evidence",
      "type": "array"
    }
  },
  "required": [
    "fact_id",
    "spot_id",
    "object_id",
    "period",
    "text",
    "source_ids",
    "source_locator",
    "keywords",
    "review_status",
    "notes"
  ],
  "title": "Fact",
  "type": "object"
}
